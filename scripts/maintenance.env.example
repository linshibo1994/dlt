# 夜间维护脚本配置示例
# 使用方式:
# 1) cp scripts/maintenance.env.example scripts/maintenance.env
# 2) 按需修改下面变量

# 本地文件清理配置（冒号分隔）
LOCAL_CLEAN_DIRS=logs:cache:artifacts/cache:test_results/logs:test_results/reports:test_results/tmp:tmp
LOCAL_PATTERN_ROOTS=logs:test_results:artifacts
LOCAL_FILE_PATTERNS=*.log:*.out:*.err:*.tmp
# 排除目录（相对项目根目录，冒号分隔），默认保留维护日志目录
LOCAL_CLEAN_EXCLUDE_DIRS=logs/maintenance

# 本地清理日志
LOCAL_CLEANUP_LOG_FILE=logs/maintenance/local_cleanup.log

# Docker 清理策略
DOCKER_CLEAN_STOPPED_CONTAINERS=true
DOCKER_CLEAN_UNUSED_IMAGES=true
DOCKER_IMAGE_MODE=all
DOCKER_CLEAN_BUILD_CACHE=true
DOCKER_BUILDER_MODE=all
DOCKER_CLEAN_UNUSED_NETWORKS=true
# 如需清理未使用卷，改为 true（注意可能删除不再挂载但需要保留的数据）
DOCKER_CLEAN_UNUSED_VOLUMES=false

# 可选过滤器（示例：until=24h）
DOCKER_PRUNE_FILTER=

# Docker 清理日志
DOCKER_CLEANUP_LOG_FILE=logs/maintenance/docker_cleanup.log

# 夜间总任务日志
NIGHTLY_MAINTENANCE_LOG_FILE=logs/maintenance/nightly_maintenance.log

# Cron 安装配置（每天 00:30）
CRON_SCHEDULE='30 0 * * *'
CRON_TASK_TAG=DLT_NIGHTLY_MAINTENANCE
CRON_LOG_FILE=logs/maintenance/cron.log
