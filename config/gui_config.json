{
  "gui": {
    "title": "大乐透智能预测系统",
    "theme": "light",
    "language": "zh-CN",
    "auto_refresh": true,
    "refresh_interval": 30,
    "page_config": {
      "page_title": "大乐透预测系统",
      "page_icon": "🎯",
      "layout": "wide",
      "initial_sidebar_state": "expanded"
    }
  },
  "prediction": {
    "default_periods": 500,
    "default_count": 1,
    "default_acceleration": "auto",
    "compound": {
      "default_front_count": 8,
      "default_back_count": 4,
      "max_cost": 10000,
      "min_confidence": 0.5
    }
  },
  "analysis": {
    "default_periods": 800,
    "chart_height": 400,
    "show_statistics": true,
    "auto_generate_report": false
  },
  "optimization": {
    "default_gpu_memory_limit": 4,
    "default_cpu_threads": 4,
    "default_batch_size": 64,
    "cache_ttl_hours": 24
  },
  "learning": {
    "default_trials": 1000,
    "default_algorithm": "UCB1",
    "show_progress": true,
    "auto_save_results": true
  },
  "backtest": {
    "default_test_periods": 100,
    "default_confidence_threshold": 0.6,
    "show_charts": true,
    "compare_algorithms": true
  },
  "display": {
    "max_table_rows": 100,
    "decimal_places": 3,
    "show_tooltips": true,
    "animation_enabled": true
  },
  "performance": {
    "enable_caching": true,
    "lazy_loading": true,
    "batch_processing": true,
    "memory_optimization": true
  }
}
